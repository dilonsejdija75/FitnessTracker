{
  "name": "NutritionLog",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date"
    },
    "meal_type": {
      "type": "string",
      "enum": [
        "breakfast",
        "lunch",
        "dinner",
        "snack"
      ]
    },
    "food_name": {
      "type": "string"
    },
    "calories": {
      "type": "number"
    },
    "protein_g": {
      "type": "number"
    },
    "carbs_g": {
      "type": "number"
    },
    "fat_g": {
      "type": "number"
    },
    "fiber_g": {
      "type": "number"
    },
    "serving_size": {
      "type": "string"
    },
    "quantity": {
      "type": "number",
      "default": 1
    }
  },
  "required": [
    "date",
    "meal_type",
    "food_name",
    "calories"
  ]
}